{
  "name": "matts-second-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/stdio.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "tsc --noEmit",
    "models:download": "tsx scripts/download-model.ts",
    "test:semantic": "tsx scripts/semantic-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "nsx:inspect": "tsx scripts/inspect-nsx.ts",
    "nsx:validate": "tsx scripts/validate-nsx.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cheerio": "1.1.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "ipaddr.js": "2.2.0",
    "lucide-react": "0.468.0",
    "multer": "2.0.2",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.5",
    "three": "0.186.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.3",
    "@types/three": "0.186.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vitest": "3.2.4"
  }
}
