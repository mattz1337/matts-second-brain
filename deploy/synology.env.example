# Copy to .env next to compose.synology.yml. Example paths and URL must be customized.
APP_ORIGIN=https://brain.example.com
APP_PORT=4310
APP_BIND_IP=127.0.0.1
ALLOW_LAN_HTTP=false
ORBIT_IMAGE=ghcr.io/mattz1337/orbit:0.2.0
APP_UID=1000
APP_GID=1000
DATA_PATH=/volume1/docker/orbit/data
PASSWORD_HASH_PATH=/volume1/docker/orbit/secrets/owner-password.json
EMBEDDINGS=local
# Leave empty unless you know the exact reverse proxy peer address/subnet.
TRUST_PROXY=
