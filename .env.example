PORT=4310
HOST=127.0.0.1
# Keep local for desktop development. NAS/server deployment uses password.
ACCESS_MODE=local
# Password mode requires an HTTPS origin and a generated password hash file.
# APP_ORIGIN=https://brain.example.com
# OWNER_PASSWORD_HASH_FILE=.secrets/owner-password.json
# Optional exact trusted proxy IPs/CIDRs, comma separated. Empty trusts none.
# TRUST_PROXY=172.17.0.1
DATA_DIR=.data
SEED_DEMO=true
# Local inference; downloads public model weights once, never sends your text out.
EMBEDDINGS=local
EMBEDDING_THREADS=2
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEMANTIC_MIN_SCORE=0.8
CATEGORY_MIN_SIMILARITY=0.78
CATEGORY_AUTO_SIMILARITY=0.82
# Use EMBEDDINGS=lexical to run without a model download (semantic search disabled).
# Optional local LLM extraction, otherwise exact sentence candidates are used.
EXTRACTION=extractive
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
