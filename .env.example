PORT=4310
DATA_DIR=.data
SEED_DEMO=true
# Local inference; downloads public model weights once, never sends your text out.
EMBEDDINGS=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEMANTIC_MIN_SCORE=0.8
# Use EMBEDDINGS=lexical to run without a model download (semantic search disabled).
# Optional local LLM extraction, otherwise exact sentence candidates are used.
EXTRACTION=extractive
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
